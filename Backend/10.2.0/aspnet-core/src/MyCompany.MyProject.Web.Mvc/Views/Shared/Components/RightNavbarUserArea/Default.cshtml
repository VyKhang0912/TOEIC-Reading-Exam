@model MyCompany.MyProject.Web.Views.Shared.Components.RightNavbarUserArea.RightNavbarUserAreaViewModel
@if (Model.LoginInformations?.User != null)
{
    <li class="nav-item dropdown nav-user-menu">
        <a href="javascript:void(0);" class="nav-link" data-bs-toggle="dropdown" role="button">
            <img class="user-image img-circle elevation-2" src="~/img/avatar.png" alt="User Image">
        </a>
        <div class="dropdown-menu dropdown-menu-right">
            <a class="dropdown-item" asp-controller="Users" asp-action="ChangePassword">
                <i class="fas fa-user-edit"></i> @L("UpdatePassword")
            </a>
            <a class="dropdown-item" asp-controller="Account" asp-action="Logout">
                <i class="fas fa-sign-out-alt"></i> @L("Logout")
            </a>
        </div>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-controller="Account" asp-action="Login">
            <i class="fas fa-sign-in-alt mr-1"></i> @L("LogIn")
        </a>
    </li>
}

